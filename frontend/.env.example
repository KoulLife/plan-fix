# Backend API root. Do not place secrets in VITE_* variables (they are exposed to the client).
VITE_API_BASE_URL=http://localhost:8080/api/v1

# 카카오맵 JavaScript 키. 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키에서 확인한다.
# 브라우저에 노출되는 것이 정상인 키이며, 콘솔의 [플랫폼 > Web > 사이트 도메인] 등록으로 보호된다.
# 앱에서 카카오맵 서비스를 활성화하고, 사용할 도메인(예: http://localhost:3000)을 등록해야 동작한다.
VITE_KAKAO_JS_KEY=
